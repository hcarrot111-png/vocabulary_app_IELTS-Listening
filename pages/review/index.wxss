.filter-row{display:flex;gap:16rpx;margin-top:26rpx}.filter{background:#fff;border:2rpx solid #dfe7f0;border-radius:18rpx;font-size:24rpx;padding:16rpx 22rpx}.tool-row{display:grid;grid-template-columns:1fr 1fr 1.15fr;gap:12rpx;margin:20rpx 0}.tool-row .btn{font-size:23rpx;padding:18rpx 8rpx}.list-card{background:#fff;border-radius:24rpx;overflow:hidden}.list-head,.word-row{display:grid;grid-template-columns:1fr 1.6fr .9fr;gap:12rpx;align-items:center;padding:20rpx}.list-head{background:#f8fafc;color:#748197;font-size:22rpx}.word-row{border-top:2rpx solid #edf1f5;font-size:23rpx}.word-main{font-size:28rpx;font-weight:800;word-break:break-all}.detail-link{font-size:21rpx;color:#006eeb;background:#fff;border:0;padding:8rpx 0}.empty{text-align:center;color:#748197;padding:80rpx}.sheet{align-self:flex-end}.check-row{display:flex;align-items:center;gap:18rpx;padding:24rpx 4rpx;border-bottom:2rpx solid #edf1f5}.full{display:flex;width:100%;margin-top:26rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:2rpx solid #edf1f5}.stepper{display:flex;align-items:center;gap:26rpx}.stepper button{width:56rpx;height:56rpx;border-radius:50%;padding:0;line-height:50rpx}.mode-pill{font-size:22rpx;padding:14rpx;background:#fff;border:2rpx solid #dfe7f0}.mode-pill.active{color:#006eeb;background:#eaf4ff;border-color:#74b3ff}.drawer-mask{position:fixed;inset:0;background:rgba(15,23,36,.28);z-index:80}.drawer{position:fixed;left:26rpx;right:0;top:0;bottom:0;background:#fff;z-index:81;padding:38rpx 30rpx;box-sizing:border-box}.word-line{display:flex;align-items:center;gap:16rpx;margin-top:28rpx}.drawer-word{font-size:50rpx;font-weight:900}.drawer-meaning{font-size:31rpx;font-weight:800;margin-top:22rpx}.syn-row{display:grid;grid-template-columns:1fr 1.3fr 56rpx;align-items:center;background:#f7f9fc;border-radius:16rpx;padding:18rpx;margin-top:12rpx}.syn-en{font-weight:800}.audio.small{width:48rpx;height:48rpx;line-height:48rpx;font-size:21rpx}
