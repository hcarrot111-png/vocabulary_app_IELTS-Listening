.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:26rpx}.stat{padding:24rpx}.value{font-size:42rpx;font-weight:900;margin-top:10rpx}.note{font-size:20rpx;color:#19a566;margin-top:8rpx}.chart,.mastery{margin-top:22rpx}.chart-title{font-size:31rpx;font-weight:800}.bars{height:310rpx;display:flex;align-items:flex-end;justify-content:space-between;margin-top:34rpx;padding-top:42rpx}.bar-col{width:12%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;position:relative}.bar{width:36rpx;background:linear-gradient(#62a9ff,#0874ed);border-radius:14rpx 14rpx 4rpx 4rpx}.day{font-size:21rpx;color:#748197;margin-top:10rpx}.bubble{position:absolute;top:-10rpx;background:#172033;color:#fff;border-radius:12rpx;padding:8rpx 12rpx;font-size:20rpx;white-space:nowrap}.master-row{margin-top:28rpx}.track{height:18rpx;border-radius:20rpx;background:#edf2f7;overflow:hidden;margin-top:12rpx}.fill{height:100%;background:linear-gradient(90deg,#1779ed,#60a7ff);border-radius:20rpx}
