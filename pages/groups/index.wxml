<view class="page"><view class="title">{{book.name}} · 选择词组</view><view class="sub">选择词组后，在当前页面选择复习模式</view><view class="card groups"><button wx:for="{{groups}}" wx:key="*this" class="group {{item===book.lastGroup?'active':''}}" data-group="{{item}}" bindtap="selectGroup">第{{item}}组</button></view></view>
<view class="mask" wx:if="{{modalVisible}}" bindtap="closeModal"><view class="dialog" catchtap="noop"><view class="row between"><view><view class="dialog-title">第{{selectedGroup}}组 · {{book.name}}</view><view class="sub">请选择本组词汇复习模式</view></view><view class="close" bindtap="closeModal">×</view></view><view class="mode-card" wx:for="{{modes}}" wx:key="value"><view class="mode-card-title">{{item.name}}</view><view class="sub">{{item.desc}}</view><button class="btn primary" data-mode="{{item.value}}" bindtap="enterPractice">进入练习</button></view></view></view>
