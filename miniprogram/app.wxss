page{background:#f3f7fb;color:#111827;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}
.page{padding:28rpx 28rpx 48rpx}.title{font-size:44rpx;font-weight:800}.sub{font-size:24rpx;color:#748197;line-height:1.6}.card{background:#fff;border-radius:28rpx;padding:30rpx;box-shadow:0 12rpx 34rpx rgba(30,50,80,.07)}
.btn{display:inline-flex;align-items:center;justify-content:center;border:2rpx solid #006eeb;color:#006eeb;background:#fff;border-radius:20rpx;padding:19rpx 26rpx;font-weight:700;font-size:26rpx;line-height:1}.btn.primary{background:#006eeb;color:#fff}.btn.ghost{border-color:#dbe5f0;color:#526175}.row{display:flex;align-items:center}.between{justify-content:space-between}.hidden{display:none}
.mask{position:fixed;inset:0;background:rgba(15,23,36,.35);backdrop-filter:blur(12rpx);z-index:90;display:flex;align-items:center;justify-content:center;padding:34rpx}.dialog{width:100%;background:rgba(255,255,255,.97);border-radius:34rpx;padding:32rpx}.dialog-title{font-size:36rpx;font-weight:800}.close{width:58rpx;height:58rpx;border-radius:50%;background:#eef2f7;text-align:center;line-height:58rpx;font-size:36rpx}.mode-card{border:2rpx solid #e5ebf2;border-radius:24rpx;padding:26rpx;margin-top:20rpx}.mode-card-title{font-size:32rpx;font-weight:800}.mode-card .btn{display:flex;margin-top:22rpx}
.hl{background:#ffe4a1;color:#835600;border-radius:8rpx;padding:0 6rpx;font-weight:800}.tag{display:inline-block;background:#eaf4ff;color:#075ebf;border-radius:12rpx;padding:8rpx 14rpx;font-size:22rpx}.danger-tag{background:#fff0ed;color:#d64b36}.section{margin-top:26rpx;padding-top:24rpx;border-top:2rpx solid #edf1f5}.section-title{font-size:28rpx;font-weight:800;margin-bottom:14rpx}.box{background:#f6f9fc;border-radius:18rpx;padding:22rpx;line-height:1.75}.audio{width:58rpx;height:58rpx;border-radius:50%;background:#eaf4ff;color:#006eeb;text-align:center;line-height:58rpx}.bottom-actions{display:flex;gap:16rpx;margin-top:28rpx}.bottom-actions .btn{flex:1}
