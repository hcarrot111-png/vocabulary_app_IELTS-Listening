<view class="page"><view class="title">复习</view><view class="sub">答错的词会自动加入这里，可按词书和最近练习时间筛选</view>
 <view class="filter-row"><button class="filter" bindtap="openBookFilter">{{bookLabel}}⌄</button><button class="filter" bindtap="openTimeFilter">{{timeLabel}}⌄</button></view>
 <view class="tool-row"><button class="btn ghost" bindtap="exportList">导出⌄</button><button class="btn ghost" bindtap="openSettings">复习设置</button><button class="btn primary" bindtap="startReview">开始复习</button></view>
 <view class="list-card"><view class="list-head"><text>单词</text><text>释义 / 最近练习</text><text>词书</text></view><view class="word-row" wx:for="{{filtered}}" wx:key="id"><view class="word-main">{{item.word}}</view><view><view>{{item.pos}} {{item.meaning}}</view><view class="sub">{{item.lastTime}}</view></view><view><view class="tag">{{item.book}}</view><button class="detail-link" data-id="{{item.id}}" bindtap="openDetail">查看详情</button></view></view><view class="empty" wx:if="{{!filtered.length}}">当前条件下暂无错词</view></view>
</view>

<view class="mask" wx:if="{{filterVisible}}" bindtap="closeFilter"><view class="dialog sheet" catchtap="noop"><view class="row between"><view class="dialog-title">{{filterType==='book'?'选择词书':'选择练习时间'}}</view><view class="close" bindtap="closeFilter">×</view></view><checkbox-group bindchange="changeFilter"><label class="check-row" wx:for="{{filterOptions}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#006eeb"/><text>{{item.label}}</text></label></checkbox-group><button class="btn primary full" bindtap="applyFilter">确定</button></view></view>

<view class="mask" wx:if="{{settingsVisible}}" bindtap="closeSettings"><view class="dialog sheet" catchtap="noop"><view class="row between"><view class="dialog-title">复习设置</view><view class="close" bindtap="closeSettings">×</view></view><view class="setting-row"><text>每组单词</text><view class="stepper"><button bindtap="minus">−</button><text>{{count}}</text><button bindtap="plus">＋</button></view></view><view class="setting-row"><text>复习模式</text><view><button class="mode-pill {{reviewMode==='practice'?'active':''}}" data-mode="practice" bindtap="changeMode">练习模式</button><button class="mode-pill {{reviewMode==='flash'?'active':''}}" data-mode="flash" bindtap="changeMode">速刷模式</button></view></view><button class="btn primary full" bindtap="closeSettings">确定</button></view></view>

<view class="drawer-mask" wx:if="{{detailVisible}}" bindtap="closeDetail"></view><scroll-view scroll-y class="drawer" wx:if="{{detailVisible}}"><view class="row between"><view class="sub">上次练习时间：{{detail.lastTime}}</view><view class="close" bindtap="closeDetail">×</view></view><view class="word-line"><view class="drawer-word">{{detail.word}}</view><view class="audio" data-word="{{detail.word}}" bindtap="playAny">🔊</view></view><view class="sub">{{detail.phon}}</view><view class="detail-meta" wx:if="{{detail.type==='answer'||detail.type==='topic'}}"><view class="detail-chip" wx:if="{{detail.type==='topic'&&detail.topic}}">单词话题 <text>{{detail.topic}}</text></view><view class="detail-chip" wx:if="{{detail.difficulty}}">单词难度 <text>{{detail.difficulty}}</text></view></view><view class="drawer-meaning">{{detail.pos}} {{detail.meaning}}</view>
 <block wx:if="{{detail.type==='key'}}"><view class="section"><view class="section-title">同义替换</view><view class="syn-row" wx:for="{{detail.synonyms}}" wx:key="en"><text class="syn-en">{{item.en}}</text><text>{{item.zh}}</text><view class="audio small" data-word="{{item.en}}" bindtap="playAny">🔊</view></view></view><view class="section"><view class="section-title">题目原文</view><view class="box"><text wx:for="{{questionParts}}" wx:key="index" class="{{item.hl?'hl':''}}">{{item.text}}</text></view></view><view class="section"><view class="section-title">对应原文</view><view class="box"><text wx:for="{{correspondingParts}}" wx:key="index" class="{{item.hl?'hl':''}}">{{item.text}}</text></view></view><view class="section"><view class="section-title">对应原文中文翻译</view><view class="box"><text wx:for="{{translationParts}}" wx:key="index" class="{{item.hl?'hl':''}}">{{item.text}}</text></view></view></block>
 <block wx:else><view class="section"><view class="section-title">例句</view><view class="box"><text wx:for="{{exampleParts}}" wx:key="index" class="{{item.hl?'hl':''}}">{{item.text}}</text></view></view><view class="section"><view class="section-title">例句中文译文</view><view class="box"><text wx:for="{{translationParts}}" wx:key="index" class="{{item.hl?'hl':''}}">{{item.text}}</text></view></view></block>
</scroll-view>
