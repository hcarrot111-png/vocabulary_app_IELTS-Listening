<view class="page"><view class="title">学习统计</view><view class="sub">查看词汇学习进度与近七天练习表现</view><view class="summary-grid"><view class="card stat" wx:for="{{summaries}}" wx:key="label"><view class="sub">{{item.label}}</view><view class="value">{{item.value}}</view><view class="note">{{item.note}}</view></view></view>
 <view class="card chart"><view class="chart-title">近7天学习趋势</view><view class="sub">点击柱形可查看当天复习数量</view><view class="bars"><view class="bar-col" wx:for="{{trend}}" wx:key="day" data-index="{{index}}" bindtap="showPoint"><view class="bubble" wx:if="{{activePoint===index}}">{{item.value}}个</view><view class="bar" style="height:{{item.height}}rpx"></view><view class="day">{{item.day}}</view></view></view></view>
 <view class="card mastery"><view class="chart-title">词汇掌握度</view><view class="master-row" wx:for="{{mastery}}" wx:key="name"><view class="row between"><text>{{item.name}}</text><text>{{item.value}}%</text></view><view class="track"><view class="fill" style="width:{{item.value}}%"></view></view></view></view>
</view>
