.custom-nav{height:176rpx;padding:86rpx 28rpx 18rpx;background:#fff;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:800;box-sizing:border-box}.nav-back{position:absolute;left:28rpx;font-size:52rpx;font-weight:400}.practice-page{padding-bottom:34rpx}.practice-card{background:#fff;border-radius:30rpx;padding:34rpx 24rpx;min-height:850rpx;margin-top:22rpx}.center{text-align:center}.word-line{display:flex;align-items:center;justify-content:center;gap:16rpx;margin-top:70rpx}.word{font-size:58rpx;font-weight:900}.phon{color:#748197;margin-top:15rpx}.meaning{font-size:32rpx;font-weight:800;margin-top:24rpx}.tip{display:inline-block;background:#eaf4ff;border-radius:16rpx;padding:14rpx 20rpx;margin:30rpx 0}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.option{border:2rpx solid #e4eaf2;border-radius:20rpx;padding:18rpx 8rpx}.option.selected{border-color:#006eeb;background:#eef6ff}.option.correct{border-color:#19a566;background:#effbf5}.option.wrong{border-color:#df4a35;background:#fff2f2}.big-audio{width:150rpx;height:150rpx;border-radius:50%;background:#eaf4ff;color:#006eeb;font-size:56rpx;line-height:150rpx;margin:100rpx auto 24rpx}.spell-input{height:90rpx;border:2rpx solid #dfe7f0;border-radius:18rpx;margin:38rpx 20rpx;padding:0 22rpx;text-align:left}.choice{border:2rpx solid #e4eaf2;border-radius:18rpx;padding:24rpx;text-align:left;margin-top:16rpx}.choice.selected{border-color:#006eeb;background:#eef6ff}.choice.correct{border-color:#19a566;background:#effbf5}.feedback{margin-top:26rpx;font-weight:800}.feedback.ok{color:#19a566}.feedback.bad{color:#df4a35}.syn-row{display:grid;grid-template-columns:1fr 1.3fr 60rpx;align-items:center;text-align:left;border-top:2rpx solid #edf1f5;padding:18rpx}.syn-en{font-weight:800}.audio.small{width:50rpx;height:50rpx;line-height:50rpx}.zh{margin-top:14rpx}
